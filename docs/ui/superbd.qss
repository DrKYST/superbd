/* Таблица стилей клиента СуперБД — перенос токенов макета (docs/ui/mockup/common.css) в Qt.
   Подключение: qApp->setStyleSheet(содержимое файла из ресурса :/style/superbd.qss).
   Имена objectName (#...) задаются в формах .ui — см. docs/ui/ui-spec.md, раздел 4. */

* { font-family: Arial; font-size: 10pt; color: #333333; }
QMainWindow, QDialog { background: #ffffff; }

/* Панель разделов (сверху) */
#sectionBar { background: #f5f5f5; border-bottom: 1px solid #c9c9c9; min-height: 64px; max-height: 64px; }
#sectionBar QToolButton { width: 112px; min-width: 104px; max-width: 104px; min-height: 60px; max-height: 60px; padding: 0 3px; border: 1px solid transparent; background: transparent; font-size: 8.5pt; }
#sectionBar QToolButton:hover { background: #ebebeb; }
#sectionBar QToolButton:checked { background: #fcefbf; border: 1px solid #e0c255; }
#userLogin { color: #4d4d4d; font-size: 9pt; }
QLabel#userSeparator { color: #9a9a9a; font-size: 9pt; }

/* Панель навигации раздела (слева) */
#navPanel { background: #ffffff; border-right: 1px solid #d6d6d6; min-width: 208px; max-width: 208px; }
#navPanel QLabel[role="group"] { font-weight: bold; color: #4d4d4d; font-size: 9.5pt; padding: 10px 12px 3px 12px; }
#navPanel QPushButton[role="link"] { border: none; background: transparent; color: #1a5ba6; text-align: left; padding: 3px 12px 3px 20px; }
#navPanel QPushButton[role="link"]:hover { text-decoration: underline; }
#navPanel QPushButton[role="link"]:checked { font-weight: bold; color: #333333; background: #efefef; }

/* Вкладки открытых окон: полоса #windowTabs (QWidget) с QTabBar над QStackedWidget */
#windowTabs { background: #e9e9e9; border-bottom: 1px solid #bdbdbd; min-height: 27px; max-height: 27px; }
#windowTabs QTabBar::tab { background: #dcdcdc; border: 1px solid #bdbdbd; border-bottom: none; padding: 3px 10px; font-size: 9pt; min-height: 16px; margin-right: 2px; }
#windowTabs QTabBar::tab:selected { background: #ffffff; font-weight: bold; }
#windowTabs::pane { border-top: 1px solid #bdbdbd; }

/* Заголовок формы */
QLabel#formTitle { font-size: 14pt; color: #4d4d4d; }
QLabel#formTitleNote { font-size: 10pt; color: #8a8a8a; }

/* Кнопки командной панели */
QPushButton { min-height: 22px; max-height: 22px; padding: 0 9px; border: 1px solid #b3b3b3; border-radius: 3px;
  background: qlineargradient(x1:0, y1:0, x2:0, y2:1, stop:0 #ffffff, stop:1 #e8e8e8); }
QPushButton:hover { border-color: #8c8c8c; }
QPushButton:default, QPushButton[role="default"] { font-weight: bold; border-color: #b8900c;
  background: qlineargradient(x1:0, y1:0, x2:0, y2:1, stop:0 #fff6cc, stop:1 #f2cf4f); }
QPushButton:disabled { color: #9a9a9a; }
QToolButton#pickButton { width: 20px; height: 20px; border: 1px solid #a6a6a6; border-left: none;
  background: qlineargradient(x1:0, y1:0, x2:0, y2:1, stop:0 #ffffff, stop:1 #e8e8e8); }

/* Поля ввода */
QLineEdit, QComboBox, QDateEdit, QDateTimeEdit, QSpinBox, QDoubleSpinBox { min-height: 20px; border: 1px solid #a6a6a6; border-radius: 2px; padding: 0 5px; background: #ffffff; }
QLineEdit:read-only { background: #f3f3f3; }
QLabel[role="caption"] { color: #4d4d4d; }
QLabel[role="hint"] { color: #666666; font-size: 9pt; }
QLabel[role="ok"] { color: #2c7a2c; }
QGroupBox { border: 1px solid #cfcfcf; margin-top: 8px; padding: 6px 10px 9px 10px; }
QGroupBox::title { subcontrol-origin: margin; left: 8px; padding: 0 4px; color: #4d4d4d; }

/* Таблицы */
QTableView { border: 1px solid #b8b8b8; gridline-color: #e2e2e2; background: #ffffff;
  selection-background-color: #fbe7a1; selection-color: #333333; alternate-background-color: #ffffff; }
QHeaderView::section { background: qlineargradient(x1:0, y1:0, x2:0, y2:1, stop:0 #fafafa, stop:1 #e6e6e6);
  border: none; border-right: 1px solid #cccccc; border-bottom: 1px solid #b8b8b8; padding: 0 6px; min-height: 22px; }
QLabel#gridCaption { font-weight: bold; color: #4d4d4d; }

/* Панель страниц под таблицей */
#pagerBar { background: #f5f5f5; border: 1px solid #b8b8b8; border-top: 1px solid #d4d4d4; min-height: 26px; max-height: 26px; }
#pagerBar QLabel { font-size: 9pt; color: #444444; }

/* Блоки начальной страницы */
QFrame[role="block"] { border: 1px solid #d0d0d0; background: #ffffff; }
QLabel[role="blockTitle"] { font-weight: bold; color: #4d4d4d; padding: 0 10px; min-height: 25px;
  background: qlineargradient(x1:0, y1:0, x2:0, y2:1, stop:0 #fafafa, stop:1 #ececec); border-bottom: 1px solid #d0d0d0; }

/* Строка состояния */
QStatusBar { background: #efefef; border-top: 1px solid #c9c9c9; min-height: 22px; }
QStatusBar QLabel { font-size: 8.5pt; color: #4d4d4d; padding: 0 8px; }
QStatusBar::item { border: none; }

/* Добавлено при разработке клиента (элементы макета, не описанные выше) */
QPushButton[role="link"] { border: none; background: transparent; color: #1a5ba6; padding: 0; min-height: 0; text-align: left; }
QPushButton[role="link"]:hover { color: #10407a; text-decoration: underline; }
QPushButton[role="link"][strong="true"], QLabel[strong="true"] { font-weight: bold; }
#sectionBar QPushButton[role="link"] { font-size: 9pt; }
QLabel#dialogHeading { font-size: 11.5pt; color: #4d4d4d; }
QLabel#roleTitle { font-size: 13.5pt; color: #333333; }
QLabel[role="muted"] { color: #666666; }
QLabel[role="kbd"] { border: 1px solid #b3b3b3; border-radius: 3px; padding: 0 5px; font-size: 8.5pt; min-width: 12px; min-height: 18px;
  background: qlineargradient(x1:0, y1:0, x2:0, y2:1, stop:0 #ffffff, stop:1 #ececec); }
QFrame#blockSeparator { border: none; border-top: 1px solid #e2e2e2; max-height: 1px; }
QCheckBox { color: #4d4d4d; }
QFrame#commandSeparator { border: none; background: #cccccc; min-width: 1px; max-width: 1px; min-height: 20px; max-height: 20px; }
QPushButton#moreButton::menu-indicator { image: none; width: 0; }
/* Ячейки таблиц рисуются стилем, а не системной темой: текущая строка — жёлтая и без фокуса (.g .tr.cur) */
QTableView::item { border: none; padding: 0 4px; }
QTableView::item:selected, QTableView::item:selected:!active { background: #fbe7a1; color: #333333; }
QPushButton#periodButton::menu-indicator { image: none; width: 0; }

