d" target="t_ref_subscriber_type"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="e_R5" value="" style="edgeStyle=entityRelationEdgeStyle;html=1;rounded=0;strokeColor=#000000;strokeWidth=1.2;startArrow=ERzeroToMany;startFill=0;startSize=10;endFill=0;endSize=10;endArrow=ERmandOne;" edge="1" parent="1" source="c_core_contract_provider_id" target="t_core_provider"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="e_R6" value="" style="edgeStyle=entityRelationEdgeStyle;html=1;rounded=0;strokeColor=#000000;strokeWidth=1.2;startArrow=ERzeroToMany;startFill=0;startSize=10;endFill=0;endSize=10;endArrow=ERmandOne;" edge="1" parent="1" source="c_core_contract_subscriber_id" target="t_core_subscriber"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="e_R7" value="" style="edgeStyle=entityRelationEdgeStyle;html=1;rounded=0;strokeColor=#000000;strokeWidth=1.2;startArrow=ERzeroToMany;startFill=0;startSize=10;endFill=0;endSize=10;endArrow=ERmandOne;" edge="1" parent="1" source="c_core_session_contract_id" target="t_core_contract"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="e_R8" value="" style="edgeStyle=entityRelationEdgeStyle;html=1;rounded=0;strokeColor=#000000;strokeWidth=1.2;startArrow=ERzeroToMany;startFill=0;startSize=10;endFill=0;endSize=10;endArrow=ERmandOne;" edge="1" parent="1" source="c_core_session_tariff_id" target="t_ref_tariff"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="e_R9" value="" style="edgeStyle=entityRelationEdgeStyle;html=1;rounded=0;strokeColor=#000000;strokeWidth=1.2;startArrow=ERzeroToMany;startFill=0;startSize=10;endFill=0;endSize=10;endArrow=ERzeroToOne;" edge="1" parent="1" source="c_sec_app_user_provider_id" target="t_core_provider"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="legend" value="У каждой таблицы есть первичный ключ «Код» (id, целое, генерируется СУБД) — на диаграмме не показан; внешний ключ ссылается на код таблицы-родителя.&lt;br&gt;Жирным над линией — поля, входящие в первичный ключ вместе с кодом.&lt;br&gt;Со стороны родителя: две черты — «ровно один», кружок с чертой — «ноль или один» (внешний ключ может быть пустым).&lt;br&gt;Со стороны потомка: кружок с «вороньей лапкой» — «ноль или много».&lt;br&gt;Журнал изменений не связан внешними ключами: записи журнала сохраняются после удаления строк." style="text;html=1;align=left;verticalAlign=top;whiteSpace=wrap;fontSize=11;strokeColor=#000000;dashed=1;fillColor=#FFFFFF;spacing=6;fontFamily=Arial;fontColor=#000000;" vertex="1" parent="1"><mxGeometry x="40" y="938" width="760" height="114" as="geometry"/></mxCell></root></mxGraphModel></diagram></mxfile>
